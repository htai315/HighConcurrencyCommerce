{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Reporting": {
    "LowStockThreshold": 5
  },
  "ProductMedia": {
    "RootPath": "product-media",
    "MaxFileBytes": 8388608
  },
  "CarrierLabels": {
    "RootPath": "carrier-labels",
    "MaxFileBytes": 5242880
  },
  "DatabaseMigrations": {
    "ValidateOnStartup": true,
    "LockTimeoutSeconds": 120
  },
  "GoogleAuth": {
    "Enabled": false,
    "ClientId": ""
  },
  "PayOs": {
    "Enabled": false,
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "ReturnUrl": "http://localhost:5173/payment/payos/return",
    "CancelUrl": "http://localhost:5173/payment/payos/return?cancel=1",
    "RequestTimeoutSeconds": 10,
    "AttemptResolutionDelaySeconds": 15,
    "CheckoutUrlAllowedHosts": ["pay.payos.vn"]
  },
  "AuthEmail": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SenderAddress": "no-reply@hcc.local",
    "SenderDisplayName": "HighConcurrencyCommerce",
    "FrontendBaseUrl": "http://localhost:5173",
    "EnableSsl": false
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "CatalogSearch": {
    "SuggestionPermitLimit": 60
  },
  "AllowedHosts": "*"
}
