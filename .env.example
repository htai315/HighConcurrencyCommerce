# Local Docker Compose only. Copy to .env and replace the password.
POSTGRES_DB=highcommerce
POSTGRES_USER=highcommerce
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8080
# In production, set your public HTTPS base URL (e.g. https://badminton.example.com)
PUBLIC_WEB_URL=http://localhost:8080

# PayOS remains disabled until T19 provider-contract acceptance.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8080/payment/payos/return
PAYOS_CANCEL_URL=http://localhost:8080/payment/payos/return?cancel=1

